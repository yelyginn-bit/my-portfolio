# ============================================================================
# Переменные окружения yelyginn.ru. Скопируй в .env (локально) и/или внеси в
# Project Settings → Environment Variables хостинга (serverless читает их в api/*).
#
# ПРИНЦИП: пусто = фича выключена, сайт работает в dev-режиме (localStorage,
# имитация оплаты, без облака). Заполняешь группу — фича включается.
#
# ПРЕФИКСЫ:
#  • VITE_*  — попадают в браузерный бандл (публичные). НЕЛЬЗЯ класть секреты!
#  • без VITE_ — только serverless (api/*). Сюда service_role, секреты, токены.
# ============================================================================

# ─── Self-URL ────────────────────────────────────────────────────────────
# Базовый адрес сайта (для deep-link бота, callback'ов, абсолютных ссылок).
APP_URL="https://yelyginn.ru"
# База для serverless API на фронте. Пусто = "/api" в проде (Vercel-функции),
# "/api" в dev через Vite proxy. Меняй только если api/ на отдельном домене.
VITE_API_URL=""

# ─── Аналитика (загружается только после согласия пользователя) ───────────
# Google Analytics 4, формат G-XXXXXXXXXX. Пусто = не подключать.
VITE_GA_ID=""
# Числовой ID счётчика Яндекс Метрики. Пусто = не подключать.
# После заполнения автоматически отправляются цели:
# lead_submit, telegram_click, calculator_use, portfolio_view,
# discuss_project_click.
VITE_YANDEX_METRIKA_ID=""

# ─── Supabase (Этап A) — реальная БД ───────────────────────────────────────
# Settings → API. Заданы VITE_* пара → фронт уходит с localStorage на Postgres.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""
# Серверный URL (дублирует VITE_SUPABASE_URL; serverless берёт его). Можно тот же.
SUPABASE_URL=""
# Service role — ТОЛЬКО serverless, НИКОГДА не в VITE_*! (Settings → API)
SUPABASE_SERVICE_ROLE_KEY=""
# JWT-секрет проекта (Settings → API → JWT Secret) — подпись клиентских/админских
# токенов в /api/auth-session и /api/admin-login (RLS-мост). Только серверный!
SUPABASE_JWT_SECRET=""

# ─── Админка ───────────────────────────────────────────────────────────────
# Серверный пароль (/api/admin-login). Предпочтительно — не попадает в бандл.
ADMIN_PASSWORD=""
# Клиентский fallback (dev, без сервера). Попадает в бандл — в проде используй ADMIN_PASSWORD.
VITE_ADMIN_PASSWORD=""

# ─── Вход и уведомления через Telegram-бота ────────────────────────────────
# Токен бота от BotFather (вход клиентов по коду + уведомления админу).
TELEGRAM_BOT_TOKEN=""
# Куда слать лиды/оплаты/комментарии (твой chat_id или id канала/группы).
TELEGRAM_CHAT_ID=""
# Username бота без @ — для deep-link при первичной привязке аккаунта.
TELEGRAM_BOT_USERNAME=""
# Секрет вебхука (любая случайная строка). Тот же передаётся в
# /api/telegram-set-webhook?secret=... при установке вебхука.
TELEGRAM_WEBHOOK_SECRET=""

# ─── Хранилище файлов / галереи: Cloudflare R2 (Этап B) ────────────────────
# Провайдер на фронте: "local" (IndexedDB, dev) | "r2" (прод). Переключай в "r2"
# "supabase" работает с приватным bucket media; "r2" требует R2_* ниже.
VITE_STORAGE_PROVIDER="local"
VITE_SUPABASE_STORAGE_BUCKET="media"
SUPABASE_STORAGE_BUCKET="media"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Публичный домен бакета (если включён public access) — иначе ссылки подписываются.
R2_PUBLIC_BASE=""

# ─── Видео: Cloudflare Stream (Этап E) ─────────────────────────────────────
# Customer-код для плеера (фронт). Задан → видео грузится в Stream.
VITE_CF_STREAM_CUSTOMER=""
# Серверные: account id + API-токен с правами Stream + лимит длительности (сек).
CF_STREAM_ACCOUNT_ID=""
CF_STREAM_TOKEN=""
CF_STREAM_MAX_DURATION="3600"

# ─── Оплаты: ЮKassa (Этап F) ───────────────────────────────────────────────
# Пусто = dev-режим (оплата имитируется, заказ помечается оплаченным на фронте).
# shopId + секретный ключ из ЛК ЮKassa. Вебхук → /api/payment-webhook.
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET=""

# ─── Не используется текущим кодом ─────────────────────────────────────────
# AI-теги/поиск/лица сейчас на mock-сервисе (src/lib/ai.ts, face.ts). Ключ
# нужен только если подключишь реальный vision-API. Можно не задавать.
GEMINI_API_KEY=""
