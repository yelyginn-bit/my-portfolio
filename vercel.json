{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/prices", "destination": "/ceny", "permanent": true },
    { "source": "/privacy-policy.html", "destination": "/privacy-policy", "permanent": true },
    { "source": "/cases", "destination": "/portfolio", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(self)" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; script-src 'self' 'unsafe-inline' https://mc.yandex.ru https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https://kinescope.io https://*.kinescope.io; frame-src https://kinescope.io https://*.kinescope.io; connect-src 'self' https://mc.yandex.ru https://mc.yandex.com https://www.google-analytics.com https://*.supabase.co https://kinescope.io https://*.kinescope.io; font-src 'self' data:" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/v3-assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/privacy-policy", "destination": "/legal.html" },
    { "source": "/personal-data-consent", "destination": "/legal.html" },
    { "source": "/cookie-policy", "destination": "/legal.html" },
    { "source": "/terms", "destination": "/legal.html" },
    { "source": "/payment-terms", "destination": "/legal.html" },
    { "source": "/cancellation-refund", "destination": "/legal.html" },
    { "source": "/gallery-terms", "destination": "/legal.html" },
    { "source": "/data-request", "destination": "/legal.html" },
    { "source": "/photo", "destination": "/photo.html" },
    { "source": "/portfolio", "destination": "/index.html" },
    { "source": "/portfolio/camera", "destination": "/index.html" },
    { "source": "/portfolio/post", "destination": "/index.html" },
    { "source": "/portfolio/reels", "destination": "/portfolio-reels.html" },
    { "source": "/portfolio/events", "destination": "/portfolio-events.html" },
    { "source": "/portfolio/concerts", "destination": "/portfolio-concerts.html" },
    { "source": "/portfolio/photo", "destination": "/portfolio-photo.html" },
    { "source": "/portfolio/editing", "destination": "/portfolio-editing.html" },
    { "source": "/portfolio/:path*", "destination": "/project.html" },
    { "source": "/project", "destination": "/project.html" },
    { "source": "/content-day", "destination": "/content-day.html" },
    { "source": "/reels", "destination": "/reels.html" },
    { "source": "/reklamnye-roliki", "destination": "/reklamnye-roliki.html" },
    { "source": "/event-video", "destination": "/event-video.html" },
    { "source": "/video-dlya-marketpleysov", "destination": "/video-dlya-marketpleysov.html" },
    { "source": "/ceny", "destination": "/ceny.html" },
    { "source": "/calculator", "destination": "/calculator.html" },
    { "source": "/account", "destination": "/account.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/g/:token", "destination": "/gallery.html" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/journal", "destination": "/journal.html" },
    { "source": "/journal/:slug", "destination": "/journal.html" },
    { "source": "/blog", "destination": "/index.html" },
    { "source": "/blog/:slug", "destination": "/blog/:slug.html" }
  ]
}
