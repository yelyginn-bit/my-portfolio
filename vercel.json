{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "https://www.yelyginn.ru/:path*",
      "destination": "https://yelyginn.ru/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/privacy-policy", "destination": "/privacy-policy.html" },
    { "source": "/photo", "destination": "/photo.html" },
    { "source": "/portfolio", "destination": "/portfolio.html" },
    { "source": "/portfolio/:path*", "destination": "/project.html" },
    { "source": "/project", "destination": "/project.html" },
    { "source": "/reels", "destination": "/reels.html" },
    { "source": "/reklamnye-roliki", "destination": "/reklamnye-roliki.html" },
    { "source": "/event-video", "destination": "/event-video.html" },
    { "source": "/video-dlya-marketpleysov", "destination": "/video-dlya-marketpleysov.html" },
    { "source": "/ceny", "destination": "/ceny.html" }
  ]
}
